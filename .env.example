ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Opcional: usar agentes externos en vez de API dentro de la app.
# Activa solo cuando tengas el CLI instalado y quieras que Streamlit lo ejecute.
AGENT_HARNESS_ENABLE_RUN=0
AGENT_HARNESS_TIMEOUT_SEC=1800

