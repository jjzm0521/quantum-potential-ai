# El flujo nuevo (CLI `qpot` manejado por tu agente) NO necesita ninguna API key.
# Este archivo solo documenta variables OPCIONALES.

# Carpeta de sesión del CLI (por defecto ./session)
# QPOT_SESSION_DIR=session
# QPOT_WORKSPACE_DIR=workspace

# Certificación remota COMSOL 5.6 (usa ~/.ssh; nunca guardes contraseñas aquí)
# QPOT_COMSOL_SSH_HOST=usuario@asus
# QPOT_COMSOL_REMOTE_DIR=C:/qpot-validation
# QPOT_COMSOL_REMOTE_COMMAND=cd C:/ruta/quantum-potential-ai && python scripts/comsol56_worker.py "{design}" "{result}"

# --- Solo si vas a correr el pipeline histórico en legacy/ (con API de Anthropic) ---
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
